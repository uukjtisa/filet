<?xml version="1.0" encoding="utf-8"?>
<!--
  Filet launcher icon - monochrome layer (Android 13+ themed icons).

  Same geometry as the foreground, one colour. The system tints this using the
  alpha channel, so the fill colour here is arbitrary - what matters is that the
  gap between body and flap is a real gap, which is why both shapes are drawn
  separately rather than one being cut out of the other.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
      The same 0.8 the foreground uses, for the same reason and it must stay the
      same number. A themed icon and a normal one that differ in size by five per
      cent look like a rendering bug on the home screen, not like two layers.
    -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.8"
        android:scaleY="0.8">

        <path
            android:fillColor="#FFFFFF"
            android:pathData="M26,24h16l6,8h30a6,6 0 0 1 6,6v8H16V30a6,6 0 0 1 6,-6z" />

        <path
            android:fillColor="#FFFFFF"
            android:pathData="M24,53h64a4,4 0 0 1 3.9,4.9l-5.6,24A6,6 0 0 1 80.4,86H21a4,4 0 0 1 -3.9,-4.9l5.6,-24A6,6 0 0 1 24,53z" />
    </group>

</vector>
