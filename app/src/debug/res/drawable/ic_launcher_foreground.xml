<?xml version="1.0" encoding="utf-8"?>
<!--
  The DEBUG launcher icon.

  Identical geometry to the release mark, different colours - amber instead of the release
  teal. Same shape so it still reads as Filet; different hue so which one is on screen is
  answerable at a glance from the launcher, which it was not before.

  Geometry is deliberately copied rather than shared. A debug icon that pulled its paths from
  the release one through a colour reference would put a `@color` in the release drawable, and
  `check-icon.mjs` reads literal fills there to prove the gap between the two shapes is real
  geometry rather than a background-coloured shape painted on top. Keeping the copy means the
  release icon's check stays exactly as strict as it was; `check-icon.mjs` now also asserts the
  two files have the SAME pathData and DIFFERENT fills, so the copy cannot silently drift.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 0.8 about the canvas centre. Not the 0.945 that merely fits the square:
         see the header - a round mask is the binding constraint, not the square one. -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.8"
        android:scaleY="0.8">

        <!-- body + tab (shade) -->
        <path
            android:fillColor="#8A5A2B"
            android:pathData="M26,24h16l6,8h30a6,6 0 0 1 6,6v8H16V30a6,6 0 0 1 6,-6z" />

        <!-- front flap (accent) -->
        <path
            android:fillColor="#D99A5B"
            android:pathData="M24,53h64a4,4 0 0 1 3.9,4.9l-5.6,24A6,6 0 0 1 80.4,86H21a4,4 0 0 1 -3.9,-4.9l5.6,-24A6,6 0 0 1 24,53z" />
    </group>

</vector>
