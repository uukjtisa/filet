*.iml
.gradle
/local.properties
/.idea/caches
/.idea/libraries
/.idea/modules.xml
/.idea/workspace.xml
/.idea/navEditor.xml
/.idea/assetWizardSettings.xml
.DS_Store
/build
/captures
.externalNativeBuild
.cxx
local.properties

# ── added for the public repo ──
# Everything below is either machine-specific, generated, or not ours to publish.

# Android Studio's project metadata. Some of it is portable, most of it is one
# developer's window layout and caches; publishing the lot invites merge noise.
/.idea/
*.iml

# Gradle and Kotlin build state.
.gradle/
.kotlin/
build/
*/build/

# Signing material. Nothing here should ever exist in the tree, but a rule that
# only matters once is still worth having.
*.jks
*.keystore
*.p12
*.pem
*.pk8
keystore.properties
signing.properties

# Gate artefacts pulled off a device. These come from a real phone and can carry
# real filenames, so they are collected into build/ and never committed.
/build/gates/

# The fixture APK is generated by tools/fixture/build.sh, and the build tree it
# leaves behind is not interesting.
/tools/fixture/build/

# ── working notes, not the app ──
#
# The line is between DESIGN and SCAFFOLDING, not between code and prose.
#
# The design and evidence documents ARE published — PLAN.md, SEARCH.md,
# NEARBY.md, TEMPLATE.md, and the FEATURES / GATES / FIXES ledgers, all in
# docs/. The README
# claims every assertion is checkable; those files are what make that true, and
# excluding them would leave the claim with nothing behind it.
#
# What stays local is the scaffolding: one machine's setup log, and the notes
# written to brief whoever was working on it next. Neither tells a reader
# anything about the app.
/SETUP.md
/YOUR-CHECKS.md
/CLAUDE.md
/HANDOFF*.md
# The decision log. It records why a fork was taken the way it was, including where a
# judgement was overruled and by whom - which is a conversation between two people about this
# app, and the repository's voice rule is that there is only one developer in it. The reasoning
# that belongs in the code is in the code; this is the part that does not.
/DECISIONS.md
/*-SPEC.md

# A JVM that dies (a Gradle daemon out of memory) writes these into whatever
# directory it was started from, which is usually this one.
hs_err_pid*.log
replay_pid*.log

# Source art for the launcher icon. The rendered assets ship in app/src/main/res.
/icon/

# Working ledgers for a review round. Scaffolding, not the product.
.unlazy/

# The NDK build tree. The vendored libarchive SOURCE is committed; its objects are not.
/core-native/build/
/core-native/.cxx/
.damaged.txt

# Python bytecode. `pc-drives.py` imports `filet-sim.py` by path to reuse its mDNS record
# builders, and importing it writes a cache next to it.
__pycache__/
*.pyc

# The report backend keeps its secrets out of the tree.
report-api/node_modules/
report-api/.vercel/
report-api/.env
report-api/.env*.local

# Competitor research: prices, ratings and claims as observed on a date, kept on disk only.
/docs/COMPETITORS.md
/docs/COMPETITORS-FILEMANAGERS.md
